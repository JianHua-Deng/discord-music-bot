TOKEN=your_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
# Optional: register slash commands instantly to one guild during development.
GUILD_ID=
# Optional but recommended for reliable YouTube playback. Treat this like a password.
YT_COOKIE=
# Uses yt-dlp/youtube-dl-exec for playback streams. Keep true unless you are debugging.
YT_USE_YTDLP=true
# Optional: ERROR by default. Use WARNING or DEBUG only while debugging YouTube parser issues.
YTJS_LOG_LEVEL=ERROR
# Optional: set true to show YouTube parser shape-change warnings.
YT_PARSER_WARNINGS=false
